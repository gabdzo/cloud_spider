{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gabdzo/cloud_spider/schemas/vault.schema.json",
  "title": "Cloud Spider vault (cloudspider/v1)",
  "description": "One vault file: a service or project, who owns it, what it is made of, its SLOs and dependencies. src/vault-schema.js is the source of truth; test/vault-validate.test.js keeps the two in step.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "cloudspider/v1"
    },
    "kind": {
      "enum": [
        "Vault",
        "Perk"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "number",
        "description",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "lowercase, digits, dashes; unique in the folder"
        },
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999,
          "description": "shown as VAULT 101; unique in the folder"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "a team or a person"
        },
        "contact": {
          "type": "string",
          "minLength": 1,
          "description": "an email or a chat channel"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "static-site",
            "service",
            "api",
            "cluster",
            "worker",
            "data",
            "other"
          ]
        },
        "cluster": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "perkOf": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "perkId": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "workloads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "namespace",
              "kind",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "kind": {
                "enum": [
                  "Deployment",
                  "StatefulSet",
                  "DaemonSet",
                  "CronJob",
                  "Job",
                  "Service",
                  "Rollout",
                  "DeploymentConfig"
                ]
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
              },
              "context": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "oneOf": [
              {
                "required": [
                  "vault"
                ]
              },
              {
                "required": [
                  "service"
                ]
              },
              {
                "required": [
                  "database"
                ]
              },
              {
                "required": [
                  "queue"
                ]
              },
              {
                "required": [
                  "external"
                ]
              }
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "vault",
                    "service"
                  ]
                },
                {
                  "required": [
                    "vault",
                    "database"
                  ]
                },
                {
                  "required": [
                    "vault",
                    "queue"
                  ]
                },
                {
                  "required": [
                    "vault",
                    "external"
                  ]
                },
                {
                  "required": [
                    "service",
                    "database"
                  ]
                },
                {
                  "required": [
                    "service",
                    "queue"
                  ]
                },
                {
                  "required": [
                    "service",
                    "external"
                  ]
                },
                {
                  "required": [
                    "database",
                    "queue"
                  ]
                },
                {
                  "required": [
                    "database",
                    "external"
                  ]
                },
                {
                  "required": [
                    "queue",
                    "external"
                  ]
                }
              ]
            },
            "properties": {
              "vault": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "service": {
                "type": "string",
                "pattern": "^[a-z0-9-]+/[a-z0-9:.*/-]+$",
                "description": "a SERVICES graph node id, e.g. shop/orders-api"
              },
              "database": {
                "type": "string",
                "minLength": 1
              },
              "queue": {
                "type": "string",
                "minLength": 1
              },
              "external": {
                "type": "string",
                "minLength": 1
              },
              "protocol": {
                "enum": [
                  "http",
                  "grpc",
                  "tcp",
                  "sql",
                  "amqp",
                  "kafka",
                  "other"
                ]
              },
              "critical": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "stack": {
          "type": "object",
          "required": [
            "dir",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "dir": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "resource": {
              "type": "string"
            }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "view": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "object",
                  "required": [
                    "output"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "output": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    }
                  }
                }
              ]
            },
            "repo": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "object",
                  "required": [
                    "output"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "output": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    }
                  }
                }
              ]
            },
            "docs": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "object",
                  "required": [
                    "output"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "output": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    }
                  }
                }
              ]
            },
            "dashboard": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "object",
                  "required": [
                    "output"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "output": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    }
                  }
                }
              ]
            },
            "runbook": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "object",
                  "required": [
                    "output"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "output": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    }
                  }
                }
              ]
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "http": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "oneOf": [
                      {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https?://"
                      },
                      {
                        "type": "object",
                        "required": [
                          "output"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "output": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                          }
                        }
                      }
                    ]
                  },
                  "expect": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "contains": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeout": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 30000
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "slos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "sli",
              "source",
              "target"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "sli": {
                "enum": [
                  "availability",
                  "latency",
                  "error-rate"
                ]
              },
              "source": {
                "type": "string",
                "pattern": "^(checks|check:[^\\s].{0,80}|alb|lambda|ec2|resources|kube:api|kube:nodes|kube:restarts(:[a-z0-9-]+/[a-z0-9.-]+)?)$"
              },
              "target": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "e.g. 99.5% or 99.5"
              },
              "window": {
                "type": "string",
                "pattern": "^\\d{1,3}[hd]$"
              },
              "threshold": {
                "type": "number",
                "description": "latency SLOs: milliseconds"
              },
              "percentile": {
                "enum": [
                  "p50",
                  "p90",
                  "p95",
                  "p99"
                ]
              },
              "cluster": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
