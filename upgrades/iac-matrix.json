{
  "_doc": "Every stack x its sample configs, run under Pulumi mocks (scripts/iac-matrix.mjs; CI .github/workflows/iac.yml). expect: resources (at least min) or error (match). observability reads ELBv2 with the AWS SDK directly: fakeElb starts a local stand-in (scripts/fake-elbv2.mjs).",
  "entries": [
    {
      "id": "eks-default",
      "dir": "upgrades/eks",
      "project": "cloudspider-upgrade",
      "stack": "upgrade",
      "config": {
        "clusterName": "cloudspider-up"
      },
      "env": {
        "CLOUDSPIDER_MOCK_EKS_ADDONS": "{}"
      },
      "min": 30
    },
    {
      "id": "eks-committed",
      "dir": "upgrades/eks",
      "project": "cloudspider-upgrade",
      "stack": "upgrade",
      "configFile": "upgrades/eks/Pulumi.upgrade.yaml",
      "env": {
        "CLOUDSPIDER_MOCK_EKS_ADDONS": "{}"
      },
      "min": 30
    },
    {
      "id": "eks-new-small-spot-auto",
      "dir": "upgrades/eks",
      "project": "cloudspider-upgrade",
      "stack": "eks-small",
      "config": {
        "clusterName": "small",
        "capacityType": "SPOT",
        "maxPods": "auto"
      },
      "env": {
        "CLOUDSPIDER_MOCK_EKS_ADDONS": "{}"
      },
      "min": 30
    },
    {
      "id": "eks-spot-auto-no-prefix",
      "dir": "upgrades/eks",
      "project": "cloudspider-upgrade",
      "stack": "eks-small",
      "config": {
        "clusterName": "small",
        "capacityType": "SPOT",
        "maxPods": "auto",
        "prefixDelegation": "off"
      },
      "env": {
        "CLOUDSPIDER_MOCK_EKS_ADDONS": "{}"
      },
      "expect": "error",
      "match": "nothing was created"
    },
    {
      "id": "eks-medium-110",
      "dir": "upgrades/eks",
      "project": "cloudspider-upgrade",
      "stack": "upgrade",
      "config": {
        "clusterName": "cloudspider-up",
        "instanceType": "t4g.medium",
        "maxPods": "110",
        "nodeCount": "3"
      },
      "env": {
        "CLOUDSPIDER_MOCK_EKS_ADDONS": "{}"
      },
      "min": 30
    },
    {
      "id": "eks-type-not-offered",
      "dir": "upgrades/eks",
      "project": "cloudspider-upgrade",
      "stack": "upgrade",
      "config": {
        "clusterName": "cloudspider-up"
      },
      "env": {
        "CLOUDSPIDER_MOCK_EKS_ADDONS": "{}",
        "CLOUDSPIDER_MOCK_EC2": "{\"offerings\":[]}"
      },
      "expect": "error",
      "match": "preflight failed"
    },
    {
      "id": "shopapi-default",
      "dir": "upgrades/shopapi",
      "project": "cloudspider-shopapi",
      "stack": "shopapi",
      "config": {},
      "min": 5
    },
    {
      "id": "shopapi-alb",
      "dir": "upgrades/shopapi",
      "project": "cloudspider-shopapi",
      "stack": "shopapi",
      "config": {
        "expose": "alb",
        "replicas": "3"
      },
      "min": 6
    },
    {
      "id": "demo-default",
      "dir": "upgrades/demo",
